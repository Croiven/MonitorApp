PORT=3000
# DB_PATH=data/monitor.db
# STATIC_DIR=../frontend/dist

# RuuviTag BLE scanning (requires Bluetooth on the host)
# RUUVI_ENABLED=false
# Weather (Open-Meteo, no API key — https://open-meteo.com)
# WEATHER_LAT=61.4978
# WEATHER_LON=23.7610
# WEATHER_LOCATION=Helsinki
# WEATHER_POLL_MS=1800000

# SYSTEM_POLL_MS=10000

# Spotify now playing (https://developer.spotify.com/dashboard)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# For Vite dev also add: http://127.0.0.1:5173/api/spotify/callback
# SPOTIFY_POLL_MS=5000

# Philips Hue (local bridge)
# HUE_BRIDGE_IP=192.168.1.50
# HUE_USERNAME=
# HUE_POLL_MS=5000
